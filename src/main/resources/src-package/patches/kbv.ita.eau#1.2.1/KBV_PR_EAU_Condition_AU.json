        "id": "Condition",
        "path": "Condition",
        "constraint": [
          {
            "key": "-eau-begrenzungDateFestgestelltAm",
            "severity": "error",
            "human": "Begrenzung der Datumsangabe auf 10 Zeichen JJJJ-MM-TT",
            "expression": "extension('http://hl7.org/fhir/StructureDefinition/condition-assertedDate').value.exists() implies (extension('http://hl7.org/fhir/StructureDefinition/condition-assertedDate').value as dateTime).toString().length() = 10"
          },
          {
            "key": "-eau-begrenzungDateStart",
            "severity": "error",
            "human": "Begrenzung der Datumsangabe auf 10 Zeichen JJJJ-MM-TT",
            "expression": "(onset as Period).start.exists() implies (onset as Period).start.toString().length() = 10"
          },
          {
            "key": "-eau-begrenzungDateEnd",
            "severity": "error",
            "human": "Begrenzung der Datumsangabe auf 10 Zeichen JJJJ-MM-TT",
            "expression": "(onset as Period).end.exists() implies (onset as Period).end.toString().length() = 10"
          },
          {
            "key": "-eau-begrenzungDateteilweise-arbeitsfaehig-ab",
            "severity": "error",
            "human": "Begrenzung der Datumsangabe für das Datum der teilweise arbeitsfaehig ab auf 10 Zeichen JJJJ-MM-TT",
            "expression": "extension('https://fhir.kbv.de/StructureDefinition/KBV_EX_EAU_partially_employable').exists() implies (extension('https://fhir.kbv.de/StructureDefinition/KBV_EX_EAU_partially_employable').value as dateTime).toString().length() = 10"
          },
          {
            "key": "-eau-anzahlUrsache",
            "severity": "error",
            "human": "Jede Ursache darf nur einmal vorkommen",
            "expression": "extension('http://hl7.org/fhir/StructureDefinition/condition-dueTo').value.isDistinct()"
          }
        ]
